# Backend API Server configurations
PORT=8000
HOST=0.0.0.0

# Database Settings
MONGO_URI=mongodb://localhost:27017
DB_NAME=medical_analysis

# RAG Clinical LLM Settings
# Set API_PROVIDER to 'gemini', 'openai', or 'local'
API_PROVIDER=gemini

# Insert your Gemini API Key here for live report summaries and clinical RAG advice
GEMINI_API_KEY=

# Insert your OpenAI API Key here if API_PROVIDER=openai
OPENAI_API_KEY=

# Local LLM endpoint if API_PROVIDER=local (default runs via local Ollama)
LOCAL_LLM_URL=http://localhost:11434/api/generate
